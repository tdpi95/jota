{
  "name": "poco-electron",
  "private": true,
  "version": "0.1.0",
  "description": "poco — a local-first, markdown-backed daily-tasks and journal app",
  "author": "poco",
  "main": "dist/main.js",
  "desktopName": "poco.desktop",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/assets','dist/assets',{recursive:true})\"",
    "package": "npm run package:linux",
    "package:linux": "npm run build && electron-builder --linux AppImage",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3"
  }
}
